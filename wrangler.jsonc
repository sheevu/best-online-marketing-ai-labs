{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sudarshan-ai-labs-lucknow",
  "account_id": "292a9fa6027f8da2cb79fe1b6959f93c",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    {
      "pattern": "sudarshan-ai.com/*",
      "zone_name": "sudarshan-ai.com"
    },
    {
      "pattern": "www.sudarshan-ai.com/*",
      "zone_name": "sudarshan-ai.com"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
