{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sudarshan-ai-labs-lucknow",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "sudarshan-ai.com",
      "custom_domain": true
    },
    {
      "pattern": "www.sudarshan-ai.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
